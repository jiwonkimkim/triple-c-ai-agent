# Docker 환경용 설정 파일
# 이 파일을 .env.docker 로 복사한 후 필요한 값들을 설정하세요
# cp .env.docker.example .env.docker

# Database (Docker 내부 네트워크 사용 - 수정 불필요)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD_HERE@postgres:5432/triple_c?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-change-this"

# OAuth Providers (Optional - Google 로그인 사용 시)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI APIs (Optional - Mock 모드로 테스트 가능)
# 실제 API 키가 없으면 Mock 모드로 동작합니다
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""  # Gemini 이미지 생성용

# Mock 모드 강제 사용 (true로 설정하면 API 키 없이 테스트)
USE_MOCK_AI="true"

# Image Generation (Optional)
NANOBANANA_API_KEY=""
NANOBANANA_API_URL="https://api.nanobanana.com"

# Video Generation (Optional)
RUNWAY_API_KEY=""

# S3 Storage (Optional)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""
S3_REGION="ap-northeast-2"
S3_ENDPOINT=""

# Email (Optional)
SENDGRID_API_KEY=""
EMAIL_FROM=""

# App Configuration
NODE_ENV="development"
