# Database
DATABASE_URL="postgresql://username:password@localhost:5432/triple_c?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AI APIs
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Image Generation
NANOBANANA_API_KEY="your-nanobanana-api-key"
NANOBANANA_API_URL="https://api.nanobanana.com"

# Video Generation (Runway)
RUNWAY_API_KEY="your-runway-api-key"

# Vector Database (Pinecone)
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="triple-c-brands"
PINECONE_REGION="us-east-1"

# S3 Compatible Storage
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"
S3_BUCKET_NAME="triple-c-assets"
S3_REGION="ap-northeast-2"
S3_ENDPOINT="https://s3.amazonaws.com"

# Email (SendGrid)
SENDGRID_API_KEY="your-sendgrid-api-key"
EMAIL_FROM="noreply@triplec.com"

# App Configuration
NODE_ENV="development"
