// Prisma Schema for Triple C Marketing Contents Agent
// Database: PostgreSQL

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================
// Auth & User Models (NextAuth Compatible)
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  // Security tracking fields
  deviceInfo   String?  @map("device_info")   // "MacBook Pro, Chrome 120"
  browser      String?                         // Browser name
  os           String?                         // Operating system
  ipAddress    String?  @map("ip_address")
  location     String?                         // Geo location from IP
  lastActive   DateTime @default(now()) @map("last_active")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  device    String?  // Device type and name
  browser   String?  // Browser name and version
  os        String?  // Operating system
  ipAddress String?  @map("ip_address")
  location  String?  // Geo location from IP
  success   Boolean  @default(true)
  failReason String? @map("fail_reason")  // For failed logins
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("login_history")
}

// ============================================
// User Model
// ============================================

enum UserType {
  B2C
  B2B
}

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  passwordHash  String?   @map("password_hash")
  name          String?
  nickname      String?
  image         String?
  industry      String?
  userType      UserType  @default(B2C) @map("user_type")
  plan          Plan      @default(FREE)
  trialCredits  Int       @default(3) @map("trial_credits")
  credits       Int       @default(0)
  stripeCustomerId    String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?  @map("stripe_subscription_id")
  stripePriceId       String?   @map("stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map("stripe_current_period_end")

  // 2FA fields
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?   @map("two_factor_secret")  // Encrypted TOTP secret

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  accounts             Account[]
  sessions             Session[]
  loginHistory         LoginHistory[]
  ownedWorkspaces      Workspace[]        @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
  projects             Project[]
  brandProfiles        BrandProfile[]
  editorDrafts         EditorDraft[]
  createdVersions      ProjectVersion[]   @relation("VersionCreator")
  subscriptions        Subscription[]
  payments             Payment[]
  creditTransactions   CreditTransaction[]

  // Marketplace relations
  templates         Template[]
  sellerBalance     SellerBalance?
  templatePurchases TemplatePurchase[] @relation("TemplateBuyer")
  templateSales     TemplatePurchase[] @relation("TemplateSeller")
  templateReviews   TemplateReview[]

  @@map("users")
}

// ============================================
// Company & Workspace Models (B2B)
// ============================================

enum CompanySize {
  SMB
  Mid
  Enterprise
}

model Company {
  id                   String       @id @default(cuid())
  name                 String
  domain               String       @unique
  businessNumber       String?      @map("business_number")
  size                 CompanySize?
  industry             String?
  monthlyContentVolume Int?         @map("monthly_content_volume")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  // Relations
  workspaces Workspace[]

  @@map("companies")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  companyId String?  @map("company_id")
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company       Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner         User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members       WorkspaceMember[]
  projects      Project[]
  brandProfiles BrandProfile[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  role        Role     @default(VIEWER)
  joinedAt    DateTime @default(now()) @map("joined_at")

  // Relations
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// ============================================
// Brand Profile & RAG Models
// ============================================

model BrandProfile {
  id            String   @id @default(cuid())
  workspaceId   String?  @map("workspace_id")
  userId        String?  @map("user_id")
  name          String
  identity      String   @db.Text
  toneAndManner String   @map("tone_and_manner") @db.Text
  voiceTone     String?  @map("voice_tone") @db.Text // Voice and tone guidelines
  styleGuide    Json?    @map("style_guide") // Brand style guide
  imageKeywords String[] @map("image_keywords")
  websiteUrl    String?  @map("website_url")
  instagramUrl  String?  @map("instagram_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  user           User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace      Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  projects       Project[]
  documentChunks BrandDocumentChunk[]

  @@map("brand_profiles")
}

enum BrandDocumentSource {
  WEBSITE
  INSTAGRAM
  UPLOAD
}

model BrandDocumentChunk {
  id             String              @id @default(cuid())
  brandProfileId String              @map("brand_profile_id")
  source         BrandDocumentSource
  content        String              @db.Text
  metadata       Json                @default("{}")
  vectorId       String?             @map("vector_id") // Reference to Pinecone vector
  createdAt      DateTime            @default(now()) @map("created_at")

  // Relations
  brandProfile BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
  @@map("brand_document_chunks")
}

// ============================================
// Project Models
// ============================================

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model Project {
  id             String        @id @default(cuid())
  ownerId        String        @map("owner_id")
  workspaceId    String?       @map("workspace_id")
  brandProfileId String?       @map("brand_profile_id")
  title          String
  description    String?       @db.Text
  content        Json?         // Current content (sections)
  currentVersion Int           @default(0) @map("current_version")
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // 제품 정보 (재생성 시 사용)
  productName    String?       @map("product_name")
  category       String?
  subCategory    String?       @map("sub_category")  // 뷰티 서브카테고리 (skincare, lip 등)
  keyFeatures    String[]      @default([]) @map("key_features")
  targetAudience String?       @map("target_audience")
  copyLength     String?       @default("medium") @map("copy_length")
  productUrl     String?       @map("product_url")
  productImages  String[]      @default([]) @map("product_images")
  imageModel     String?       @default("gemini-2.5-flash-image") @map("image_model")

  // Relations
  owner              User                @relation(fields: [ownerId], references: [id])
  workspace          Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  brandProfile       BrandProfile?       @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)
  detailPageVersions DetailPageVersion[]
  editorDraft        EditorDraft?
  histories          ProjectHistory[]
  versions           ProjectVersion[]
  motionJobs         MotionJob[]
  videoJobs          VideoJob[]

  @@index([ownerId])
  @@index([workspaceId])
  @@map("projects")
}

// ============================================
// Detail Page Generation Models
// ============================================

enum SectionType {
  HERO
  FEATURES
  SOCIAL_PROOF
  HOW_TO_USE
  FAQ
  CUSTOM
}

enum DetailPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model DetailPageVersion {
  id            String           @id @default(cuid())
  projectId     String           @map("project_id")
  versionNumber Int              @default(1) @map("version_number")
  hookMessage   String?          @map("hook_message") @db.Text // Optional for drafts
  sections      Json?            // Array of DetailPageSection, optional for drafts
  contentJson   Json?            @map("content_json") // Editor content JSON
  contentHtml   String?          @map("content_html") @db.Text // Rendered HTML
  status        DetailPageStatus @default(DRAFT)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@map("detail_page_versions")
}

// ============================================
// Editor Models
// ============================================

model EditorDraft {
  id          String   @id @default(cuid())
  projectId   String   @unique @map("project_id")
  userId      String   @map("user_id")
  contentJson Json     @map("content_json")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("editor_drafts")
}

// ============================================
// Template Models
// ============================================

enum TemplateCategory {
  GENERIC
  FASHION
  FOOD
  BEAUTY
  DIGITAL
}

enum TemplateCreator {
  SYSTEM
  USER
}

model Template {
  id           String           @id @default(cuid())
  name         String
  category     TemplateCategory @default(GENERIC)
  thumbnailUrl String?          @map("thumbnail_url")
  sections     Json             // Array of section definitions
  isReference  Boolean          @default(false) @map("is_reference")
  createdBy    TemplateCreator  @default(USER) @map("created_by")
  userId       String?          @map("user_id") // null for SYSTEM templates
  createdAt    DateTime         @default(now()) @map("created_at")

  // Marketplace fields
  isPublished   Boolean   @default(false) @map("is_published")
  publishedAt   DateTime? @map("published_at")
  price         Int       @default(0) // 0 = FREE, in credits
  description   String?   @db.Text
  previewImages String[]  @map("preview_images")
  tags          String[]
  downloadCount Int       @default(0) @map("download_count")
  rating        Float?
  ratingCount   Int       @default(0) @map("rating_count")

  // Semantic search embedding (pgvector - bge-large-en-v1.5 1024 dimensions)
  embedding     Unsupported("vector(1024)")?
  embeddingText String?                      @map("embedding_text") @db.Text
  embeddedAt    DateTime?                    @map("embedded_at")

  // Relations
  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  purchases TemplatePurchase[]
  reviews   TemplateReview[]

  @@index([category])
  @@index([isPublished])
  @@map("templates")
}

// ============================================
// Marketplace Models
// ============================================

model TemplatePurchase {
  id            String   @id @default(cuid())
  templateId    String   @map("template_id")
  buyerId       String   @map("buyer_id")
  sellerId      String?  @map("seller_id") // null for system templates
  pricePaid     Int      @map("price_paid") // Credits spent
  sellerEarning Int      @map("seller_earning") // 70% of price
  platformFee   Int      @map("platform_fee") // 30% of price
  purchasedAt   DateTime @default(now()) @map("purchased_at")

  // Relations
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  buyer    User     @relation("TemplateBuyer", fields: [buyerId], references: [id])
  seller   User?    @relation("TemplateSeller", fields: [sellerId], references: [id])

  @@unique([templateId, buyerId]) // User can only purchase once
  @@index([buyerId])
  @@index([sellerId])
  @@index([purchasedAt])
  @@map("template_purchases")
}

model SellerBalance {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  availableCredits Int      @default(0) @map("available_credits")
  totalEarned      Int      @default(0) @map("total_earned")
  totalWithdrawn   Int      @default(0) @map("total_withdrawn")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions SellerTransaction[]

  @@map("seller_balances")
}

enum SellerTransactionType {
  SALE
  WITHDRAWAL
  REFUND
}

model SellerTransaction {
  id          String                @id @default(cuid())
  sellerId    String                @map("seller_id")
  type        SellerTransactionType
  amount      Int
  balance     Int // Balance after transaction
  description String?
  templateId  String?               @map("template_id")
  purchaseId  String?               @map("purchase_id")
  createdAt   DateTime              @default(now()) @map("created_at")

  // Relations
  sellerBalance SellerBalance @relation(fields: [sellerId], references: [userId])

  @@index([sellerId])
  @@index([createdAt])
  @@map("seller_transactions")
}

model TemplateReview {
  id         String   @id @default(cuid())
  templateId String   @map("template_id")
  userId     String   @map("user_id")
  rating     Int // 1-5
  comment    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId]) // One review per user per template
  @@index([templateId])
  @@map("template_reviews")
}

// ============================================
// Job Models (Motion/GIF, Video)
// ============================================

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MotionEffect {
  ZOOM
  PAN
  ROTATE
  BOUNCE
  FADE
  PARALLAX
}

model MotionJob {
  id           String       @id @default(cuid())
  projectId    String       @map("project_id")
  inputImages  String[]     @map("input_images") // Array of image URLs
  effect       MotionEffect @default(ZOOM)
  parameters   Json         @default("{}") // Full effect parameters
  outputUrl    String?      @map("output_url")
  status       JobStatus    @default(PENDING)
  errorMessage String?      @map("error_message")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  completedAt  DateTime?    @map("completed_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("motion_jobs")
}

model VideoJob {
  id                 String    @id @default(cuid())
  projectId          String    @map("project_id")
  status             JobStatus @default(PENDING)
  prompt             String    @db.Text
  referenceImageUrls String[]  @map("reference_image_urls")
  resultVideoUrl     String?   @map("result_video_url")
  costCredits        Int?      @map("cost_credits")
  errorMessage       String?   @map("error_message")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("video_jobs")
}

// ============================================
// History & Versioning Models
// ============================================

enum VersionAction {
  CREATE
  UPDATE
  GENERATE
  RESTORE
  AUTO_SAVE
  GENERATE_IMAGE
  GENERATE_MOTION
  EXPORT
}

model ProjectVersion {
  id            String        @id @default(cuid())
  projectId     String        @map("project_id")
  versionNumber Int           @map("version_number")
  action        VersionAction @default(UPDATE)
  description   String?       @db.Text
  content       Json          // Sections and metadata snapshot
  thumbnail     String?       // Preview image URL
  changes       Json?         // { added: number, modified: number, deleted: number }
  createdById   String        @map("created_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  // Relations
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdByUser User    @relation("VersionCreator", fields: [createdById], references: [id])

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@index([createdAt])
  @@map("project_versions")
}

model ProjectHistory {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  action    String   // Action type (CREATE, UPDATE, GENERATE, etc.)
  details   Json     @default("{}") // Action-specific details
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
  @@map("project_histories")
}

// ============================================
// File Upload Tracking
// ============================================

model UploadedFile {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  filename     String
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  url          String
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("uploaded_files")
}

// ============================================
// Payment & Subscription Models
// ============================================

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  TRIALING
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @map("user_id")
  stripeSubscriptionId String             @unique @map("stripe_subscription_id")
  stripePriceId        String             @map("stripe_price_id")
  stripeCustomerId     String             @map("stripe_customer_id")
  plan                 Plan
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime           @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?          @map("canceled_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeCustomerId])
  @@map("subscriptions")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  stripePaymentId String        @unique @map("stripe_payment_id")
  amount          Int           // in cents/smallest currency unit
  currency        String        @default("krw")
  status          PaymentStatus @default(PENDING)
  description     String?
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

enum CreditTransactionType {
  PURCHASE
  SUBSCRIPTION_RENEWAL
  USAGE
  REFUND
  BONUS
  ADMIN_ADJUSTMENT
  TEMPLATE_PURCHASE   // Buy template from marketplace
  SELLER_WITHDRAWAL   // Seller converts earnings to credits
}

model CreditTransaction {
  id          String                @id @default(cuid())
  userId      String                @map("user_id")
  type        CreditTransactionType
  amount      Int                   // positive for additions, negative for usage
  balance     Int                   // balance after transaction
  description String?
  metadata    Json                  @default("{}")
  createdAt   DateTime              @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("credit_transactions")
}

// ============================================
// A/B Testing Models
// ============================================

enum ABTestStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

model ABTest {
  id          String       @id @default(cuid())
  projectId   String       @map("project_id")
  name        String
  description String?      @db.Text
  status      ABTestStatus @default(DRAFT)
  startedAt   DateTime?    @map("started_at")
  endedAt     DateTime?    @map("ended_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  variants ABTestVariant[]
  events   ABTestEvent[]

  @@index([projectId])
  @@index([status])
  @@map("ab_tests")
}

model ABTestVariant {
  id          String  @id @default(cuid())
  testId      String  @map("test_id")
  name        String
  description String?
  content     Json    // Variant content (sections, etc.)
  weight      Int     @default(50) // Traffic allocation percentage
  isControl   Boolean @default(false) @map("is_control")

  // Relations
  test   ABTest        @relation(fields: [testId], references: [id], onDelete: Cascade)
  events ABTestEvent[]

  @@index([testId])
  @@map("ab_test_variants")
}

enum ABTestEventType {
  VIEW
  CLICK
  CONVERSION
  SCROLL
  TIME_SPENT
}

model ABTestEvent {
  id        String          @id @default(cuid())
  testId    String          @map("test_id")
  variantId String          @map("variant_id")
  type      ABTestEventType
  visitorId String          @map("visitor_id") // Anonymous visitor ID
  metadata  Json            @default("{}")
  createdAt DateTime        @default(now()) @map("created_at")

  // Relations
  test    ABTest        @relation(fields: [testId], references: [id], onDelete: Cascade)
  variant ABTestVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([variantId])
  @@index([visitorId])
  @@index([createdAt])
  @@map("ab_test_events")
}
